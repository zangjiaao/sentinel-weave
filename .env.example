# =========================
# Security Analyst Agent
# =========================

# SQLite DB path (used by CLI / MCP bridge)
SPIKE_DB_PATH=./spike.db

# Patrol trigger mode: chat | cron | openai
HERMES_PATROL_TRIGGER_MODE=openai

# Patrol runtime controls
HERMES_PATROL_MAX_TURNS=18
HERMES_PATROL_PROMPT_PATH=./hermes/patrol-prompt.md
HERMES_PATROL_JOB_ID=d27a82c0fa79

# Hermes runtime homes (only needed for chat/cron mode)
HERMES_HOME=~/.hermes
HERMES_PATROL_HOME=~/.hermes-patrol

# OpenAI runtime (used when HERMES_PATROL_TRIGGER_MODE=openai)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: set when using proxy / gateway / compatible endpoint
OPENAI_BASE_URL=
OPENAI_PATROL_MODEL=gpt-5-mini
# compact (default): reduced tool set for lower token cost; full: all tools
OPENAI_PATROL_TOOL_PROFILE=compact
# when session exists, use compact resume instructions instead of full prompt+SOUL+SKILL
OPENAI_PATROL_RESUME_COMPACT_INSTRUCTIONS=true
# session rollover guardrails for long-running patrol sessions
OPENAI_PATROL_SESSION_MAX_RUNS=24
OPENAI_PATROL_SESSION_MAX_INPUT_TOKENS=300000
# if resumed session returns no backend tool calls, retry once with a fresh session
OPENAI_PATROL_RETRY_FRESH_ON_NO_TOOL=true

# Neutral workflow guardrails (recommended)
# Skip linking low+recon alerts into cases by default, and skip recon-noise-only timeline nodes.
NEUTRAL_CASE_LINK_GUARD=true
