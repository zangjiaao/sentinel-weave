# =========================
# Security Analyst Agent
# =========================

# SQLite DB path (used by CLI / MCP bridge)
SPIKE_DB_PATH=./spike.db

# Patrol trigger mode: chat | cron | openai
HERMES_PATROL_TRIGGER_MODE=openai

# Patrol runtime controls
HERMES_PATROL_MAX_TURNS=18
HERMES_PATROL_PROMPT_PATH=./hermes/patrol-prompt.md
HERMES_PATROL_JOB_ID=d27a82c0fa79

# Hermes runtime homes (only needed for chat/cron mode)
HERMES_HOME=~/.hermes
HERMES_PATROL_HOME=~/.hermes-patrol

# OpenAI runtime (used when HERMES_PATROL_TRIGGER_MODE=openai)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: set when using proxy / gateway / compatible endpoint
OPENAI_BASE_URL=
OPENAI_PATROL_MODEL=gpt-5-mini
