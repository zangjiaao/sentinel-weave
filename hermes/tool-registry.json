{
  "version": "0.2",
  "runtime": "hermes",
  "integration_mode": "local_cli",
  "tools": [
    {
      "name": "alert.fetch",
      "description": "拉取待研判告警摘要队列。",
      "when_to_use": [
        "开始一轮巡检时",
        "需要获取最近的新告警摘要时"
      ],
      "command_template": "uv run python -m security_analyst_agent.cli alert.fetch --db-path ${SPIKE_DB_PATH} --payload '${JSON_PAYLOAD}'",
      "read_only": true,
      "timeout_sec": 15,
      "cost_level": "low",
      "idempotent": true
    },
    {
      "name": "alert.detail",
      "description": "读取单条告警详情与关键证据摘要。",
      "when_to_use": [
        "需要深入确认某条告警细节时",
        "需要补充告警证据字段时"
      ],
      "command_template": "uv run python -m security_analyst_agent.cli alert.detail --db-path ${SPIKE_DB_PATH} --payload '${JSON_PAYLOAD}'",
      "read_only": true,
      "timeout_sec": 15,
      "cost_level": "low",
      "idempotent": true
    },
    {
      "name": "alert.ack",
      "description": "将已处理告警标记为 triaged/closed，避免重复出队。",
      "when_to_use": [
        "告警已经完成本轮研判时",
        "需要避免同一告警在后续巡检重复汇报时"
      ],
      "command_template": "uv run python -m security_analyst_agent.cli alert.ack --db-path ${SPIKE_DB_PATH} --payload '${JSON_PAYLOAD}'",
      "read_only": false,
      "timeout_sec": 15,
      "cost_level": "low",
      "idempotent": true
    },
    {
      "name": "asset.search",
      "description": "按指标搜索资产并返回资产上下文。",
      "when_to_use": [
        "需要确认被攻击对象归属时",
        "需要关联公网IP与业务系统时"
      ],
      "command_template": "uv run python -m security_analyst_agent.cli asset.search --db-path ${SPIKE_DB_PATH} --payload '${JSON_PAYLOAD}'",
      "read_only": true,
      "timeout_sec": 15,
      "cost_level": "low",
      "idempotent": true
    },
    {
      "name": "case.get",
      "description": "读取案件头部摘要与当前风险结论。",
      "when_to_use": [
        "需要查看案件状态时",
        "需要获得案件核心字段时"
      ],
      "command_template": "uv run python -m security_analyst_agent.cli case.get --db-path ${SPIKE_DB_PATH} --payload '${JSON_PAYLOAD}'",
      "read_only": true,
      "timeout_sec": 15,
      "cost_level": "low",
      "idempotent": true
    },
    {
      "name": "case.timeline",
      "description": "读取案件时间线与攻击阶段演进。",
      "when_to_use": [
        "需要还原攻击链过程时",
        "需要判断阶段是否升级时"
      ],
      "command_template": "uv run python -m security_analyst_agent.cli case.timeline --db-path ${SPIKE_DB_PATH} --payload '${JSON_PAYLOAD}'",
      "read_only": true,
      "timeout_sec": 15,
      "cost_level": "low",
      "idempotent": true
    },
    {
      "name": "case.explain-link",
      "description": "解释事件与案件之间的关联依据。",
      "when_to_use": [
        "需要说明为何属于同一攻击链时",
        "需要输出结构化关联理由时"
      ],
      "command_template": "uv run python -m security_analyst_agent.cli case.explain-link --db-path ${SPIKE_DB_PATH} --payload '${JSON_PAYLOAD}'",
      "read_only": true,
      "timeout_sec": 15,
      "cost_level": "low",
      "idempotent": true
    },
    {
      "name": "case.upsert",
      "description": "创建或更新案件主记录。",
      "when_to_use": [
        "识别到新案件需要建档时",
        "需要维护案件标题、状态、风险等级时"
      ],
      "command_template": "uv run python -m security_analyst_agent.cli case.upsert --db-path ${SPIKE_DB_PATH} --payload '${JSON_PAYLOAD}'",
      "read_only": false,
      "timeout_sec": 20,
      "cost_level": "medium",
      "idempotent": true
    },
    {
      "name": "case.link-alert",
      "description": "将告警关联到指定案件并记录关联理由。",
      "when_to_use": [
        "确认告警属于某个案件时",
        "需要补充案件与告警的关联依据时"
      ],
      "command_template": "uv run python -m security_analyst_agent.cli case.link-alert --db-path ${SPIKE_DB_PATH} --payload '${JSON_PAYLOAD}'",
      "read_only": false,
      "timeout_sec": 20,
      "cost_level": "medium",
      "idempotent": true
    },
    {
      "name": "case.update-risk",
      "description": "更新案件风险等级、攻击阶段与处置状态。",
      "when_to_use": [
        "新证据导致风险升级或降级时",
        "案件处置状态变化时"
      ],
      "command_template": "uv run python -m security_analyst_agent.cli case.update-risk --db-path ${SPIKE_DB_PATH} --payload '${JSON_PAYLOAD}'",
      "read_only": false,
      "timeout_sec": 20,
      "cost_level": "medium",
      "idempotent": true
    },
    {
      "name": "evidence.upsert",
      "description": "写入或更新案件证据记录。",
      "when_to_use": [
        "需要把漏洞利用、webshell、横向扫描等证据沉淀为结构化记录时",
        "需要让后续案件时间线或评估引用该证据时"
      ],
      "command_template": "uv run python -m security_analyst_agent.cli evidence.upsert --db-path ${SPIKE_DB_PATH} --payload '${JSON_PAYLOAD}'",
      "read_only": false,
      "timeout_sec": 20,
      "cost_level": "medium",
      "idempotent": true
    },
    {
      "name": "timeline.upsert",
      "description": "写入或更新时间线节点，沉淀攻击过程。",
      "when_to_use": [
        "需要把多条告警和证据合并成一个攻击步骤时",
        "需要把攻击链过程结构化到案件时间线时"
      ],
      "command_template": "uv run python -m security_analyst_agent.cli timeline.upsert --db-path ${SPIKE_DB_PATH} --payload '${JSON_PAYLOAD}'",
      "read_only": false,
      "timeout_sec": 20,
      "cost_level": "medium",
      "idempotent": true
    },
    {
      "name": "assessment.upsert",
      "description": "写入实体级风险评估（攻击IP/失陷主机/噪音来源）。",
      "when_to_use": [
        "需要把攻击者或失陷主机沉淀为结构化结论时",
        "需要更新实体当前风险结论并保留历史记录时"
      ],
      "command_template": "uv run python -m security_analyst_agent.cli assessment.upsert --db-path ${SPIKE_DB_PATH} --payload '${JSON_PAYLOAD}'",
      "read_only": false,
      "timeout_sec": 20,
      "cost_level": "medium",
      "idempotent": true
    },
    {
      "name": "intel.lookup",
      "description": "查询缓存化威胁情报用于补证。",
      "when_to_use": [
        "案件证据不足且需要外部情报佐证时",
        "需要评估指标历史风险时"
      ],
      "command_template": "uv run python -m security_analyst_agent.cli intel.lookup --db-path ${SPIKE_DB_PATH} --payload '${JSON_PAYLOAD}'",
      "read_only": true,
      "timeout_sec": 25,
      "cost_level": "medium",
      "idempotent": true
    },
    {
      "name": "notify.send",
      "description": "触发模拟通知发送并写入通知出站记录。",
      "when_to_use": [
        "案件风险达到升级阈值时",
        "需要通知值守团队并做去重控制时"
      ],
      "command_template": "uv run python -m security_analyst_agent.cli notify.send --db-path ${SPIKE_DB_PATH} --payload '${JSON_PAYLOAD}'",
      "read_only": false,
      "timeout_sec": 20,
      "cost_level": "high",
      "idempotent": true
    },
    {
      "name": "notify.preview",
      "description": "生成通知预览草稿，不进行实际发送。",
      "when_to_use": [
        "调试通知模板时",
        "需要人工预览通知内容时"
      ],
      "command_template": "uv run python -m security_analyst_agent.cli notify.preview --db-path ${SPIKE_DB_PATH} --payload '${JSON_PAYLOAD}'",
      "read_only": true,
      "timeout_sec": 15,
      "cost_level": "medium",
      "idempotent": true
    },
    {
      "name": "report.draft",
      "description": "生成案件分析报告草稿。",
      "when_to_use": [
        "用户明确请求导出案件报告时",
        "需要产出可复盘的结构化报告草稿时"
      ],
      "command_template": "uv run python -m security_analyst_agent.cli report.draft --db-path ${SPIKE_DB_PATH} --payload '${JSON_PAYLOAD}'",
      "read_only": true,
      "timeout_sec": 20,
      "cost_level": "medium",
      "idempotent": true
    }
  ]
}
